{
  "extends": "@cabinet/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "test/**/*"
  ]
}