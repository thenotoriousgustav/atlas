datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  password     String
  name         String
  avatar       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  refreshTokens RefreshToken[]
  folders       Folder[]
  bookmarks     Bookmark[]
  vehicles      Vehicle[]
  fetchHistories FetchHistory[]
  fetchCollections FetchCollection[]
  credentials   UserCredential[]
  habitTrackers   HabitTracker[]
  habitCategories HabitCategory[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Folder {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  description String?
  parentId    String?    @db.Uuid
  userId      String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderToFolder")
  bookmarks Bookmark[]

  @@map("folders")
}

model Bookmark {
  id             String               @id @default(uuid()) @db.Uuid
  url            String
  canonicalUrl   String?
  title          String
  description    String?
  imageUrl       String?
  faviconUrl     String?
  siteName       String?
  provider       BookmarkProvider?
  contentType    BookmarkContentType?
  metadataStatus MetadataStatus       @default(PENDING)
  metadataError  String?
  metadata       Json?
  lastEnrichedAt DateTime?
  isFavorite     Boolean              @default(false)
  isArchived     Boolean              @default(false)
  folderId       String?              @db.Uuid
  userId         String               @db.Uuid
  status         String               @default("OK")
  statusCode     Int?
  position       Int                  @default(0)
  lastChecked    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags   Tag[]   @relation("BookmarkTags")

  @@index([provider])
  @@index([metadataStatus])
  @@map("bookmarks")
}

enum BookmarkProvider {
  REDDIT
}

enum BookmarkContentType {
  SOCIAL_POST
  IMAGE
  VIDEO
  ARTICLE
  LINK
  UNKNOWN
}

enum MetadataStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[] @relation("BookmarkTags")

  @@map("tags")
}

model Vehicle {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  brand         String
  model         String
  variant       String?
  year          Int
  plateNumber   String
  vin           String?
  engineNumber  String?
  chassisNumber String?
  purchasePrice Float?
  purchaseDate  DateTime?
  odometer      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances Maintenance[]
  parts        Part[]
  fuelLogs     FuelLog[]
  expenses     Expense[]
  reminders    Reminder[]
  documents    VehicleDocument[]

  @@map("vehicles")
}

model Maintenance {
  id         String            @id @default(uuid()) @db.Uuid
  vehicleId  String            @db.Uuid
  date       DateTime          @default(now())
  odometer   Int
  workshop   String?
  notes      String?
  totalCost  Float
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items     MaintenanceItem[]
  parts     Part[]

  @@map("maintenances")
}

model MaintenanceItem {
  id            String      @id @default(uuid()) @db.Uuid
  maintenanceId String      @db.Uuid
  type          String
  cost          Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@map("maintenance_items")
}

model Part {
  id               String       @id @default(uuid()) @db.Uuid
  vehicleId        String       @db.Uuid
  maintenanceId    String?      @db.Uuid
  name             String
  brand            String?
  installedAt      DateTime?
  installedMileage Int?
  expectedLife     Int?         // expected mileage lifetime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenance Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  @@map("parts")
}

model FuelLog {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @db.Uuid
  liters    Float
  price     Float     // price per liter
  odometer  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("fuel_logs")
}

model Expense {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String    @db.Uuid
  category  String
  amount    Float
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Reminder {
  id         String    @id @default(uuid()) @db.Uuid
  vehicleId  String    @db.Uuid
  type       String
  dueDate    DateTime?
  dueMileage Int?
  status     String    @default("ACTIVE") // "ACTIVE", "COMPLETED", "OVERDUE"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model VehicleDocument {
  id             String    @id @default(uuid()) @db.Uuid
  vehicleId      String    @db.Uuid
  documentType   String    // "STNK", "Insurance", "Warranty", "Other"
  documentNumber String
  expirationDate DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_documents")
}

model FetchHistory {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  title        String
  author       String?
  platform     String
  mediaType    String           // "VIDEO", "AUDIO", "IMAGE"
  fileSize     Float?           // in bytes
  resolution   String?
  thumbnail    String?
  notes        String?
  isFavorite   Boolean          @default(false)
  collectionId String?          @db.Uuid
  collection   FetchCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@map("fetch_histories")
}

model FetchCollection {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  histories FetchHistory[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@map("fetch_collections")
}

model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  transports   String[]
  createdAt    DateTime @default(now())

  @@map("user_credentials")
}

model HabitTracker {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  category      String       @default("General")
  type          String       @default("BOOLEAN") // BOOLEAN, COUNT, DURATION, NUMERIC, AMOUNT
  goalValue     Float        @default(1)
  goalUnit      String?
  goalFrequency String       @default("DAILY") // DAILY, WEEKLY
  goalDirection String       @default("INCREASING") // INCREASING, DECREASING
  color         String       @default("emerald")
  reminderTime  String?      // e.g. "21:00"
  quickSteppers Int[]        @default([1, 5]) // e.g. [1, 5] for quick +1, +5 buttons
  archived      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  entries       HabitEntry[]

  @@map("habit_trackers")
}

model HabitEntry {
  id              String       @id @default(uuid()) @db.Uuid
  trackerId       String       @db.Uuid
  tracker         HabitTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  date            String       // Format YYYY-MM-DD
  value           Float        @default(1)
  durationSeconds Int?
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([trackerId, date])
  @@map("habit_entries")
}

model HabitCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("emerald")
  icon      String?  @default("FolderSimple")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("habit_categories")
}


