  "info": {
    "title": "Cabinet API",
    "description": "API for Cabinet bookmarks, notes, and saved reading",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cabinet.session_token"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Gustam"
          },
          "avatar": {
            "type": "string",
            "example": "https://avatar.url"
          }
        }
      },
      "SaveNoteDto": {
        "type": "object",
        "properties": {
          "folderId": {
            "type": "string",
            "description": "Destination folder for a new note"
          },
          "title": {
            "type": "string",
            "description": "Note title"
          },
          "notes": {
            "type": "string",
            "description": "Plain-text preview of the note"
          },
          "noteDocument": {
            "type": "object",
            "additionalProperties": true,
            "description": "Tiptap document JSON"
          }
        },
        "required": [
          "noteDocument"
        ]
      },
      "DownloadMediaDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
            "description": "URL of the video or media"
          },
          "formatId": {
            "type": "string",
            "example": "137+140",
            "description": "yt-dlp format ID to download"
          },
          "mediaType": {
            "type": "string",
            "example": "VIDEO",
            "description": "Type of media to download (VIDEO, AUDIO)"
          },
          "title": {
            "type": "string",
            "example": "Video Title",
            "description": "Title of the video media"
          }
        },
        "required": [
          "url",
          "mediaType",
          "title"
        ]
      },
      "CreateBookmarkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://nextjs.org",
            "description": "URL (optional for standalone notes)"
          },
          "type": {
            "type": "string",
            "enum": [
              "BOOKMARK",
              "NOTE"
            ],
            "default": "BOOKMARK",
            "description": "Item type: BOOKMARK or NOTE"
          },
          "title": {
            "type": "string",
            "example": "My Note / Bookmark Title",
            "description": "Title (auto-extracted if omitted for URLs)"
          },
          "description": {
            "type": "string",
            "example": "Quick summary or excerpt",
            "description": "Short description"
          },
          "noteDocument": {
            "type": "object",
            "additionalProperties": true,
            "description": "Structured note content"
          },
          "folderId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Folder ID"
          },
          "tags": {
            "example": [
              "React",
              "Architecture"
            ],
            "description": "List of tags",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ImportBookmarksDto": {
        "type": "object",
        "properties": {
          "htmlContent": {
            "type": "string",
            "description": "Netscape HTML bookmark file content as raw string"
          }
        },
        "required": [
          "htmlContent"
        ]
      },
      "ReorderBookmarksDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of bookmark IDs in their new order",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "BulkActionDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of bookmark IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "BulkArchiveDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of bookmark IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isArchived": {
            "type": "boolean",
            "description": "Archive status",
            "default": true
          }
        },
        "required": [
          "ids"
        ]
      },
      "BulkMoveDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of bookmark IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "folderId": {
            "type": "string",
            "description": "Target folder ID (null for root)",
            "nullable": true
          }
        },
        "required": [
          "ids"
        ]
      },
      "BulkTagsDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Array of bookmark IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "description": "Tags to add to the selected bookmarks",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids",
          "tags"
        ]
      },
      "UpdateBookmarkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://nextjs.org",
            "description": "Bookmark URL"
          },
          "type": {
            "type": "string",
            "enum": [
              "BOOKMARK",
              "NOTE"
            ],
            "description": "Item type: BOOKMARK or NOTE"
          },
          "title": {
            "type": "string",
            "example": "Next.js App Router",
            "description": "Bookmark title"
          },
          "description": {
            "type": "string",
            "example": "Next.js developer reference manual",
            "description": "Bookmark description"
          },
          "folderId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Folder ID"
          },
          "tags": {
            "example": [
              "Next.js",
              "React"
            ],
            "description": "List of tags",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isPinned": {
            "type": "boolean",
            "description": "Keep bookmark pinned above unpinned items"
          },
          "isFavorite": {
            "type": "boolean",
            "example": true,
            "description": "Is bookmarked as favorite"
          },
          "isArchived": {
            "type": "boolean",
            "example": false,
            "description": "Is bookmarked archived"
          }
        }
      },
      "CreateFolderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Resources",
            "description": "Folder name"
          },
          "description": {
            "type": "string",
            "example": "Design and dev bookmarks",
            "description": "Folder description"
          },
          "parentId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Parent folder ID"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateFolderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Resources",
            "description": "Folder name"
          },
          "description": {
            "type": "string",
            "example": "Design and dev bookmarks",
            "description": "Folder description"
          },
          "parentId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Parent folder ID"
          }
        }
      }
    }
  }
}